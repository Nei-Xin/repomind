{
  "status": "explicit-input-runtime-regression-fixtures",
  "cases": [
    {
      "id": "complete-constraint",
      "summary": "Completed the review closeout.\n\nRequire count to be an integer from 1 through 128 inclusive.\n\nImplementation remains a separate follow-up.",
