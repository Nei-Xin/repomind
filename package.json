{
  "name": "repomind",
  "version": "0.13.0",
  "description": "Evidence-backed repository memory for coding agents",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nei-Xin/repomind.git"
  },
  "homepage": "https://github.com/Nei-Xin/repomind#readme",
  "bugs": "https://github.com/Nei-Xin/repomind/issues",
  "type": "module",
  "bin": {
    "repomind": "dist/cli/index.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "benchmarks"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "coding-agent",
    "memory",
    "sqlite",
    "repository"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "start": "node dist/cli/index.js",
    "bench": "node dist/cli/index.js eval --compare --strict --json > comparison-report.json",
    "bench:agent-fixtures": "node benchmarks/agent-suite/validate.mjs",
    "bench:host-run": "npm run build --silent && node benchmarks/agent-suite/run-host.mjs",
    "bench:l2-real": "npm run build --silent && node benchmarks/layered-memory/run-l2-real.mjs",
    "bench:l3-real": "npm run build --silent && node benchmarks/layered-memory/run-l3-real.mjs",
    "bench:portability-real": "npm run build --silent && node benchmarks/portability/run-real-recovery.mjs"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "sqlite-vec": "^0.1.9",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "3.2.7",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "overrides": {
    "@hono/node-server": "^2.0.5"
  }
}
