{
  "name": "repomind",
  "version": "0.4.0",
  "description": "Evidence-backed repository memory for coding agents",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nei-Xin/repomind.git"
  },
  "homepage": "https://github.com/Nei-Xin/repomind#readme",
  "bugs": "https://github.com/Nei-Xin/repomind/issues",
  "type": "module",
  "bin": {
    "repomind": "dist/cli/index.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/cli/index.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "overrides": {
    "@hono/node-server": "^2.0.5"
  }
}
